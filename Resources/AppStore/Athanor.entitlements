<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build. scripts/build-appstore.sh adds the application
     and team identifiers, which only a distribution signature may carry. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Ready checks: a port that opens, a URL that answers. No
         network.server: Athanor listens on nothing, and App Review refuses
         it for scripts that might. A script that serves needs the runner. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The editor's folder picker, and the open panel on Application Scripts
         that lets Athanor put athanor-runner there (see Runner.swift). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
