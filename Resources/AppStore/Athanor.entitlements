<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build. scripts/build-appstore.sh adds the application
     and team identifiers, which only a distribution signature may carry. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Ready checks: a port that opens, a URL that answers. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Scripts run in Athanor's sandbox, and many of them are servers. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
